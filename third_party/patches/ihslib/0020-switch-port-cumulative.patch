+    if (n <= 0) {
+        return NULL;
+    }
+    SDL_JoystickID *ids = (SDL_JoystickID *)SDL_malloc(sizeof(SDL_JoystickID) * (size_t)n);
+    if (ids == NULL) {
+        if (count != NULL) {
+            *count = 0;
+        }
+        return NULL;
+    }
+    for (int i = 0; i < n; i++) {
